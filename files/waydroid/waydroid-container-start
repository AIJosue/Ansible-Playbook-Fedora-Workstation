#!/usr/bin/bash

# Import defaults if WIDTH/HEIGHT is not defined by an external script
if [ -z "${WAYDROID_WIDTH:-}" ] || [ -z "${WAYDROID_HEIGHT:-}" ]; then
    if [ -f /etc/default/waydroid-launcher ]; then
        source /etc/default/waydroid-launcher
    fi
fi

# Ensure needed props are present in /var/lib/waydroid/waydroid_base.prop
if [ -f "/var/lib/waydroid/waydroid_base.prop" ]; then
    if ! grep -q "persist.waydroid.udev=true" "/var/lib/waydroid/waydroid_base.prop"; then
        echo "persist.waydroid.udev=true" >> /var/lib/waydroid/waydroid_base.prop
    fi

    if ! grep -q "persist.waydroid.uevent=true" "/var/lib/waydroid/waydroid_base.prop"; then
        echo "persist.waydroid.uevent=true" >> /var/lib/waydroid/waydroid_base.prop
    fi

    if [ -n "$WAYDROID_DENSITY" ]; then
        sed -i "s/ro.sf.lcd_density=.*/ro.sf.lcd_density=${WAYDROID_DENSITY}/g" /var/lib/waydroid/waydroid_base.prop
    fi
    sed -i "s/ro.hardware.gralloc=.*/ro.hardware.gralloc=${WAYDROID_GRALLOC:-minigbm_gbm_mesa}/g" /var/lib/waydroid/waydroid_base.prop
fi

systemctl start waydroid-container.service
